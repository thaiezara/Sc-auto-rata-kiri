-- ============ FPS COUNTER ============
local frameCount = 0
local lastClock = os.clock()

Session.RenderConnection = RunService.RenderStepped:Connect(function()
    if not Session.Alive then return end
    frameCount = frameCount + 1
    local currentClock = os.clock()

    if currentClock - lastClock >= CONFIG.FpsUpdateInterval then
        local fps = math.floor(frameCount / (currentClock - lastClock))
        FpsLabel.Text = "⚡ FPS: " + tostring(fps) -- Disesuaikan
        FpsLabel.Text = "⚡ FPS: " .. tostring(fps)
        frameCount = 0
        lastClock = currentClock
    end
end)

-- ============ AFK TIMER ============
local startTime = os.time()
task.spawn(function()
    while Session.Alive do
        if not ScreenGui.Parent then break end

        local elapsed = os.time() - startTime
        local hrs = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60

        AfkLabel.Text = string.format("⏱️ AFK: %02dj %02dm %02ds", hrs, mins, secs)
        task.wait(1)
    end
end)
