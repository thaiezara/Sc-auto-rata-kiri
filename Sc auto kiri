-- BURIK GACOR (TANAH / NAPAK AMAN)
local function applyUltimateBurik()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 2
        Lighting.FogEnd = 999999
        for _, v in pairs(Lighting:GetDescendants()) do
            if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") then v:Destroy() end
        end
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            local nameLower = string.lower(obj.Name)
            local isGround = (nameLower:find("baseplate") or nameLower:find("terrain") or nameLower:find("floor") or nameLower:find("ground") or nameLower:find("land"))
            
            if not isGround then
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Texture") or obj:IsA("Decal") then 
                    obj:Destroy() 
                elseif obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                end
            else
                if obj:IsA("Texture") or obj:IsA("Decal") then
                    obj:Destroy()
                elseif obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                end
            end
        end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                for _, item in ipairs(p.Character:GetDescendants()) do
                    if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
                        item:Destroy()
                    elseif item:IsA("BasePart") then
                        item.Material = Enum.Material.SmoothPlastic
                        item.Reflectance = 0
                    end
                end
            end
        end
        
        local gardensFolder = Workspace:FindFirstChild("Gardens")
        if gardensFolder then
            for _, plot in pairs(gardensFolder:GetChildren()) do
                local plotName = plot.Name
                local isMyPlot = (plotName == "Plot_" .. LocalPlayer.Name) or (plotName == "Plot1") or (plotName:find(LocalPlayer.Name))
                
                if not isMyPlot then
                    plot:Destroy()
                else
                    for _, pPart in pairs(plot:GetDescendants()) do
                        if pPart:IsA("BasePart") then 
                            pPart.Material = Enum.Material.SmoothPlastic 
                            pPart.Reflectance = 0
                        elseif pPart:IsA("Texture") or pPart:IsA("Decal") then 
                            pPart:Destroy() 
                        end
                    end
                end
            end
        end
    end)
end

