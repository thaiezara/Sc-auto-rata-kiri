local function refreshStatus(selectionTable, statusLabel)
    local list = {}
    for name, active in pairs(selectionTable) do
        if active then table.insert(list, name) end
    end
    statusLabel.Text = #list > 0 and " Pilihan: " .. table.concat(list, ", ") or " Pilihan: (Belum ada)"
end

local function populateListScanned(folder, scrollFrame, selectionTable, statusLabel)
    if not folder then return 0 end
    local count = 0
    local currentY = 2
    for _, child in ipairs(folder:GetChildren()) do
        if child.Name ~= "" then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 24)
            btn.Position = UDim2.new(0, 4, 0, currentY)
            btn.BackgroundColor3 = Color3.fromRGB(30, 45, 30)
            btn.Text = "[ ] " .. child.Name
            btn.Font = Enum.Font.GothamBold
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextSize = 11
            btn.Parent = scrollFrame
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            
            local isSelected = false
            btn.MouseButton1Click:Connect(function()
                isSelected = not isSelected
                if isSelected then
                    btn.BackgroundColor3 = Color3.fromRGB(50, 120, 50)
                    btn.Text = "[✔] " .. child.Name
                    selectionTable[child.Name] = true
                else
                    btn.BackgroundColor3 = Color3.fromRGB(30, 45, 30)
                    btn.Text = "[ ] " .. child.Name
                    selectionTable[child.Name] = nil
                end
                refreshStatus(selectionTable, statusLabel)
            end)
            
            currentY = currentY + 28
            count = count + 1
        end
    end
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, currentY + 5)
    return count
end

