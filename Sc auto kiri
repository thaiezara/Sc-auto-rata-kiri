-- ================= EXECUTION GUARD =================
-- Biar kalau script di-inject ulang, sesi lama otomatis mati duluan
-- gak numpuk thread/loop/connection dobel-dobel
if _G.ZhubOptimizerSession then
    -- Matiin sesi lama
    _G.ZhubOptimizerSession.Alive = false
    pcall(function()
        if _G.ZhubOptimizerSession.DescendantConnection then
            _G.ZhubOptimizerSession.DescendantConnection:Disconnect()
        end
        if _G.ZhubOptimizerSession.PlayerConnection then
            _G.ZhubOptimizerSession.PlayerConnection:Disconnect()
        end
        if _G.ZhubOptimizerSession.GlobalDescendantConnection then
            _G.ZhubOptimizerSession.GlobalDescendantConnection:Disconnect()
        end
        if _G.ZhubOptimizerSession.RenderConnection then
            _G.ZhubOptimizerSession.RenderConnection:Disconnect()
        end
        for _, conn in pairs(_G.ZhubOptimizerSession.CharacterConnections or {}) do
            conn:Disconnect()
        end
    end)
end

