-- ================= HAPUS PARTIKEL & SUARA (ANTI RAM BENGKAK) =================
local function silenceInstance(v)
    pcall(function()
        if v:IsA("Sound") then
            v.Volume = 0
        elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = false
        end
    end)
end

for _, v in pairs(game:GetDescendants()) do
    silenceInstance(v)
end

Session.GlobalDescendantConnection = game.DescendantAdded:Connect(function(v)
    if not Session.Alive then return end
    silenceInstance(v)
end)

-- ================= STRIP CHARACTER (VULKAN MODE) =================
local function stripCharacter(char)
    if not Session.Alive or not char or not VulkanActive then return end
    pcall(function()
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("Accessory") then
                item:Destroy()
            elseif item:IsA("Head") then
                for _, h in pairs(item:GetChildren()) do
                    if h:IsA("Decal") then h:Destroy() end
                end
            end
        end
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Material = Enum.Material.SmoothPlastic
                part.Color = Color3.fromRGB(240, 240, 240)
            end
        end
    end)
end

-- ================= FILTER OBJEK & PLOT =================
local function isSafePlotName(objName)
    for _, keyword in ipairs(CONFIG.SafePlotKeywords) do
        if objName:find(keyword) then
            return true
        end
    end
    return objName == "1"
end

local function processObject(obj)
    if not Session.Alive or not VulkanActive then return end

    pcall(function()
        if obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
            return
        end

        local objName = obj.Name:lower()

        if objName:find("baseplate") or objName:find("ground") or objName:find("terrain") or obj:IsA("Terrain") then
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Color = Color3.fromRGB(245, 245, 245)
            end
            return
        end

        if objName:find("plot") or objName:find("base") then
            local isSafePlot = isSafePlotName(objName)

            if not isSafePlot and obj:FindFirstChild("Owner") and tostring(obj.Owner.Value) == LocalPlayer.Name then
                isSafePlot = true
            elseif not isSafePlot and objName:find(LocalPlayer.Name:lower()) then
                isSafePlot = true
            end

            if not isSafePlot then
                obj:Destroy()
                return
            end
        end

        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Color = Color3.fromRGB(255, 255, 255)
            obj.Reflectance = 0
        end
    end)
end

-- ================= TOGGLE SYSTEM =================
local function enableVulkan()
    VulkanActive = true

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 2
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    end)

    for _, v in pairs(Workspace:GetDescendants()) do processObject(v) end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then stripCharacter(p.Character) end
    end

    if Session.DescendantConnection then Session.DescendantConnection:Disconnect() end
    if Session.PlayerConnection then Session.PlayerConnection:Disconnect() end

    Session.DescendantConnection = Workspace.DescendantAdded:Connect(processObject)
    Session.PlayerConnection = Players.PlayerAdded:Connect(function(p)
        local conn
        conn = p.CharacterAdded:Connect(stripCharacter)
        Session.CharacterConnections[p] = conn
    end)

    notifyLog(
        CONFIG.BrandName .. " ⚡",
        "Mode: ON aktif! Multi-Bot Anti-Lag Ready!\n\n" .. CONFIG.PromoText
    )
end

local function disableVulkan()
    VulkanActive = false

    if Session.DescendantConnection then Session.DescendantConnection:Disconnect() end
    if Session.PlayerConnection then Session.PlayerConnection:Disconnect() end

    pcall(function()
        Lighting.GlobalShadows = OriginalShadows
        Lighting.Brightness = OriginalBrightness
        Lighting.Ambient = OriginalAmbient
        Lighting.OutdoorAmbient = OriginalOutdoorAmbient
    end)

    notifyLog(
        CONFIG.BrandName .. " 🌿",
        "Mode: OFF!\n\n" .. CONFIG.PromoText
    )
end

